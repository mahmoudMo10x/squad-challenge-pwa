{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "src/game/**/*.ts", "src/online/**/*.ts", "src/components/**/*.tsx", "src/components/**/*.ts"]
}
